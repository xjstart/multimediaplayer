<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MultiMediaPlayer</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version><Description>Windows 多画面媒体播放器</Description>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="*.lib" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MultiMediaPlayer.Core/MultiMediaPlayer.Core.csproj" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
  </ItemGroup>
</Project>
