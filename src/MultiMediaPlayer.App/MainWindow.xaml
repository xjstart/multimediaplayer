<Window x:Class="MultiMediaPlayer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MultiMediaPlayer · 多画面播放器" Width="1280" Height="850" MinWidth="680" MinHeight="350" WindowStartupLocation="CenterScreen"
 Style="{StaticResource {x:Type Window}}"
 AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing" UseLayoutRounding="True">
 <Grid x:Name="Shell" Margin="18,12,18,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderBar" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="MULTI / VIEW" FontSize="23" FontWeight="SemiBold" Foreground="#88D3F6"/><TextBlock Text="多画面媒体播放器" FontSize="11" Foreground="#8A9AB3" Margin="1,4,0,0"/></StackPanel>
   <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
    <Button Content="＋ 添加媒体" Click="Add_Click" Background="#235C79" BorderBrush="#3685A9" ToolTip="Ctrl+O · 添加本地视频或图片"/>
    <Button Content="打开工作区" Click="Open_Click"/><Button Content="保存工作区" Click="Save_Click" ToolTip="Ctrl+S"/>
    <Button Content="全屏 ↗" Click="Fullscreen_Click" ToolTip="F11 · Esc 退出"/>
   </WrapPanel>
  </Grid>
  <Border x:Name="LayoutBar" Grid.Row="1" Background="#171E29" CornerRadius="8" Padding="8,5" Margin="0,0,0,10">
   <DockPanel>
    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 / 9 画面" VerticalAlignment="Center" Foreground="#A6B5CB" Margin="12,0"/>
    <WrapPanel>
     <TextBlock Text="布局" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="#8FA0B9"/>
     <Button x:Name="AutoButton" Content="自动适配" Click="Auto_Click"/>
     <Button x:Name="GridButton" Content="均匀网格" Click="Grid_Click"/>
     <Button x:Name="FocusButton" Content="主画面 + 辅助" Click="Focus_Click"/>
     <Button x:Name="RatioButton" Content="分区比例…" Click="Ratio_Click" ToolTip="修改选中画面所在分区，或双击分隔线"/>
     <TextBlock x:Name="ModeText" Text="完整显示 · 智能排列" VerticalAlignment="Center" Foreground="#7F93AF" Margin="15,0,0,0"/>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="StageFrame" Grid.Row="2" Background="#080C12" ClipToBounds="True" Margin="0,0,0,10">
   <Canvas x:Name="Stage" SizeChanged="Stage_SizeChanged" ClipToBounds="True"/>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
    <TextBlock Text="▦" FontSize="64" Foreground="#364D67" HorizontalAlignment="Center"/>
    <TextBlock Text="把画面放在一起" FontSize="28" FontWeight="Light" Foreground="#D6E5F4" HorizontalAlignment="Center" Margin="0,18,0,12"/>
    <TextBlock Text="拖入视频和图片，自动找到合适的排列" Foreground="#8496AF" FontSize="14" HorizontalAlignment="Center"/>
    <TextBlock Text="最多 9 个画面  ·  原比例显示  ·  独立播放" Foreground="#536781" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <Border x:Name="ControlBar" Grid.Row="3" Background="#171E29" CornerRadius="8" Padding="10,8">
   <StackPanel>
    <DockPanel Margin="4,0,4,6">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="全部播放" Click="PlayAll_Click" Padding="10,5"/><Button Content="全部暂停" Click="PauseAll_Click" Padding="10,5"/><Button Content="全部重播" Click="RestartAll_Click" Padding="10,5"/></StackPanel>
     <TextBlock x:Name="SelectedText" Text="尚未选择媒体" VerticalAlignment="Center" Foreground="#AFC0D8" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <Grid x:Name="PlaybackControls">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PlayButton" Content="▶ 播放" Click="Play_Click" Padding="12,5"/>
     <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" VerticalAlignment="Center" Margin="10,0" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" PreviewKeyUp="Seek_KeyUp"/>
     <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#91A5C2"/>
     <StackPanel Grid.Column="3" Orientation="Horizontal">
      <ComboBox x:Name="RateBox" Width="76" SelectionChanged="Rate_Changed" ToolTip="播放速度"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="1.5×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox>
      <CheckBox x:Name="LoopCheck" Content="循环" Click="Loop_Click"/>
      <CheckBox x:Name="MuteCheck" Content="总静音" Click="Mute_Click"/>
      <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="60" VerticalAlignment="Center" ValueChanged="Volume_Changed" ToolTip="选中视频音量"/>
     </StackPanel>
    </Grid>
    <WrapPanel Margin="3,5,0,0">
     <TextBlock Text="画面" Foreground="#7F93AF" VerticalAlignment="Center" Margin="5,0"/>
     <ComboBox x:Name="FitBox" Width="128" SelectionChanged="Fit_Changed"><ComboBoxItem Content="完整显示"/><ComboBoxItem Content="居中裁切铺满"/></ComboBox>
     <CheckBox x:Name="HardwareCheck" Content="硬件解码" Click="Hardware_Click" ToolTip="切换后保留位置并重新载入当前视频"/>
     <Button x:Name="RelocateButton" Content="重新定位…" Padding="10,4" Click="Relocate_Click"/>
     <Button x:Name="RemoveButton" Content="移除画面" Padding="10,4" Click="Remove_Click"/>
     <TextBlock Text="拖动标题交换画面 · 拖动分隔线调整比例" Foreground="#617794" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="11"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <DockPanel x:Name="StatusBar" Grid.Row="4" Margin="4,8,4,0"><TextBlock x:Name="StatusText" Text="就绪 · Ctrl+O 添加媒体，Ctrl+S 保存工作区" Foreground="#7F93AF" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</Window>
